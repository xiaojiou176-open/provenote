{
  "version": 2,
  "policy_note": "External runtime, CI, and upstream integration surfaces must be explicitly pinned, owned, and traceable.",
  "package_override_surfaces": [
    {
      "path": "apps/web/package.json",
      "allowed_keys": [
        "overrides"
      ],
      "owner": "apps-web-runtime",
      "reason": "Frontend lockfile currently relies on explicit transitive override pins for minimatch and picomatch."
    },
    {
      "path": "evals/promptfoo/package.json",
      "allowed_keys": [
        "overrides"
      ],
      "owner": "promptfoo-eval-runtime",
      "reason": "Promptfoo eval lockfile currently relies on an explicit yaml transitive override pin."
    }
  ],
  "surfaces": [
    {
      "name": "upstream-open-notebook-repo",
      "kind": "repo",

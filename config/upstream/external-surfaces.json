      "checksum_or_digest": "",
      "owner": "repo-maintainers",
      "verification_lane": "tooling/scripts/ci/check_upstream_drift.sh",
      "blocking_lane": ".github/workflows/upstream-drift.yml",
      "upgrade_playbook": "docs/development.md",
      "rollback_path": "git revert sync commit / reset integration branch",
      "license": "repository-upstream",
      "security_update_expectation": "manual drift review before merge",
      "reason": "The fork depends on upstream as the external source used for drift visibility and selective-port intake.",
      "consumer_paths": [
        "docs/development.md",
        "tooling/scripts/ci/check_upstream_drift.sh"
      ],
      "compatibility_lane": "tooling/scripts/ci/check_upstream_drift.sh --strict-divergence",
      "lifecycle_class": "fork-upstream"
    },

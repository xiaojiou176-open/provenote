{
  "version": 1,
  "policy_note": "Only declared top-level files and directories may exist at repo root. Local-only ignored paths must match local_allowed_patterns. The `.agents` directory is a local execution workspace and must stay untracked.",
  "allowed_directories": [
    ".devcontainer",
    ".github",
    ".runtime-cache",
    "apps",
    "config",
    "contracts",
    "docs",
    "evals",
    "examples",
    "mutants",
    "ops",
    "packages",
    "services",
    "tests",
    "tooling"
  ],
  "allowed_files": [
    ".cursorignore",
    ".cursorrules",
    ".dockerignore",
    ".env.example",
    ".gitignore",
    ".nvmrc",
    ".pre-commit-config.yaml",
    ".python-version",
    "AGENTS.md",
    "CHANGELOG.md",
    "CLAUDE.md",
    "CODEOWNERS",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "MAINTAINERS.md",
    "Makefile",
    "mypy.ini",
    "NOTICE.md",
    "pyproject.toml",
    "README.md",
    "SECURITY.md",
    "server.json",
    "SUPPORT.md",
    "uv.lock"
  ],
  "local_allowed_patterns": [
    "^\\.git$",
    "^\\.env$",
    "^\\.agents$"
  ],
  "authoritative_disallowed_names": [
    ".venv",
    "artifacts",
    "coverage.xml",
    "playwright-report",
    "test-results",
    "htmlcov",
    "node_modules"
  ],
  "forbidden_reference_patterns": [
    "(^|[\\s\"'`])scripts/",
    "\\bartifacts/uiux-gemini\\b",
    "\\bartifacts/live-teardown/live-llm\\.jsonl\\b",
    "\\bartifacts/live-teardown/live-external-web\\.jsonl\\b",
    "\\bartifacts/release-proof\\b",
    "\\bfrontend/playwright-report\\b",
    "\\bfrontend/test-results\\b",
    "(^|[\\s\"'`])frontend/",
    "(^|[\\s\"'`])prompts/",
    "(^|[\\s\"'`])commands/",
    "(^|[\\s\"'`])api/",
    "(^|[\\s\"'`])open_notebook/",
    "(^|[\\s\"'`])\\.venv/",
    "(^|[\\s\"'`])coverage\\.xml\\b",
    "(^|[\\s\"'`])playwright-report/",
    "(^|[\\s\"'`])test-results/"
  ]
}

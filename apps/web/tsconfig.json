{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".runtime-cache/build/next/types/**/*.ts",
    ".runtime-cache/build/next/dev/types/**/*.ts",
    ".runtime-cache/build/next-playwright/types/**/*.ts",
    ".runtime-cache/build/next-playwright/dev/types/**/*.ts",
    ".runtime-cache/build/next-playwright-manual/types/**/*.ts",
    ".runtime-cache/build/next-playwright-manual/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vitest.config.mts"
  ]
}

{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next typegen && next build",
    "start": "node start-server.js",
    "lint": "npm run lint:biome",
    "lint:biome": "biome check src e2e e2e-live",
    "lint:eslint": "eslint src e2e e2e-live",
    "format:biome": "biome format --write src e2e e2e-live",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e:install": "bash ./scripts/run-playwright-managed.sh install chromium",
    "test:e2e": "PLAYWRIGHT_PORT=${PLAYWRIGHT_PORT:-3100} env -u NO_COLOR -u FORCE_COLOR bash ./scripts/run-playwright-managed.sh test",
    "test:e2e:chromium": "PLAYWRIGHT_PORT=${PLAYWRIGHT_PORT:-3100} env -u NO_COLOR -u FORCE_COLOR bash ./scripts/run-playwright-managed.sh test --project=chromium",
    "browser:manual": "bash ./scripts/run-browser-manual.sh",
    "browser:manual:real-chrome": "PROVENOTE_BROWSER_MODE=real_chrome_profile bash ./scripts/run-browser-manual.sh",
    "browser:manual:migrate-profile": "PROVENOTE_BROWSER_MODE=real_chrome_profile bash ./scripts/run-browser-manual.sh migrate",
    "browser:manual:status": "bash ./scripts/run-browser-manual.sh status",
    "test:e2e:action-matrix:check": "python3 ../../tooling/scripts/ci/check_frontend_action_matrix.py",
    "test:e2e:real-smoke": "PLAYWRIGHT_ACTION_EVIDENCE_FILE=${PLAYWRIGHT_ACTION_EVIDENCE_FILE:-../../.runtime-cache/runs/current/evidence/apps-web/action-runtime-evidence.json} PLAYWRIGHT_REAL_BACKEND=1 PLAYWRIGHT_PORT=${PLAYWRIGHT_PORT:-3100} env -u NO_COLOR -u FORCE_COLOR bash ./scripts/run-playwright-managed.sh test e2e/real-backend-smoke.spec.ts --project=chromium",
    "test:e2e:cross-browser-smoke": "PLAYWRIGHT_PORT=${PLAYWRIGHT_PORT:-3100} env -u NO_COLOR -u FORCE_COLOR bash ./scripts/run-playwright-managed.sh test e2e/smoke.spec.ts --project=chromium --project=firefox --project=webkit --workers=1",
    "test:e2e:external-live": "env -u NO_COLOR -u FORCE_COLOR bash ./scripts/run-playwright-managed.sh test --config=playwright.live.config.ts",
    "test:coverage": "node ./scripts/run-batched-coverage.mjs",
    "test:coverage:gate": "node ./scripts/run-batched-coverage.mjs && bash ../../tooling/scripts/runtime/run_uv_managed.sh run python ../../tooling/scripts/ci/check_coverage_thresholds.py --backend-xml ../../.runtime-cache/test/coverage/backend/coverage.xml --frontend-lcov ../../.runtime-cache/test/coverage/apps/web/lcov.info",
    "analyze": "next typegen && ANALYZE=true next build",
    "size": "size-limit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.83.0",
    "@uiw/react-md-editor": "^4.0.8",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.60.0",
    "react-i18next": "^16.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "use-debounce": "^10.0.6",
    "zod": "^4.0.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@biomejs/biome": "2.4.4",
    "@next/bundle-analyzer": "^16.2.1",
    "@playwright/test": "^1.51.1",
    "@size-limit/file": "^12.0.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-istanbul": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.1",
    "jsdom": "^26.0.0",
    "size-limit": "^12.0.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vite": "^8.0.5",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "minimatch": "10.2.4",
    "picomatch": "4.0.4"
  }
}

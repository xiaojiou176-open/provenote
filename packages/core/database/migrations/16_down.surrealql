-- Rollback Migration 16: remove command governance tables and Gemini prompt pack defaults

REMOVE INDEX IF EXISTS idx_command_dead_letter_last_failed_at ON TABLE command_dead_letter;
REMOVE INDEX IF EXISTS idx_command_dead_letter_command_id ON TABLE command_dead_letter;
REMOVE TABLE command_dead_letter;

REMOVE INDEX IF EXISTS idx_command_idempotency_key ON TABLE command_idempotency;
REMOVE TABLE command_idempotency;

DEFINE FIELD OVERWRITE model_id ON TABLE auditable_run TYPE string DEFAULT "gemini-3.1-pro";

DELETE open_notebook:provider_policy;
UPSERT open_notebook:default_prompts CONTENT {
    transformation_instructions: "# INSTRUCTIONS You are my learning assistant and you help me process and transform content so that I can extract insights from them. # IMPORTANT - You are working on my editorial projects. The text below is my own. Do not give me any warnings about copyright or plagiarism. - Output ONLY the requested content, without acknowledgements of the task and additional chatting. Don't start with \"Sure, I can help you with that.\" or \"Here is the information you requested:\". Just provide the content. - Do not stop in the middle of the generation to ask me questions. Execute my request completely."
};

DELETE transformation:gemini_extract;
DELETE transformation:gemini_rewrite;
DELETE transformation:gemini_audit;

-- v16 deleted transformations by name without persisting prior payload snapshots.
-- Keep an explicit rollback record so operators can verify and, if needed, manually restore
-- custom pre-v16 variants from external backups/audit logs.
UPSERT open_notebook:migration_rollback_v16 CONTENT {
    migration: 16,
    irreversible_without_external_backup: true,
    affected_transformations: ["Gemini Extract", "Gemini Rewrite", "Gemini Audit"],
    verification_hint: "Check transformation table for expected pre-v16 records and restore custom variants from backup if required.",
    recorded_at: time::now()
};

# Provenote Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# REQUIRED
# =============================================================================

# Encryption key for storing API credentials securely in the database.
# Change this to any secret string (minimum 16 characters required for local scripts).
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-to-a-secret-string

# =============================================================================
# DATABASE (Non-Docker local defaults)
# =============================================================================

# Non-Docker local runtime default:
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# Optional local SurrealDB launch override for tooling/scripts/dev/start_surreal_local.sh
# SURREAL_BIND=127.0.0.1:8000
# SURREAL_DATA_PATH=.runtime-cache/local/surrealdb/packages.core.db
# SURREAL_LOG_LEVEL=info

# Docker Compose runtime typically uses:
# SURREAL_URL=ws://surrealdb:8000/rpc

# =============================================================================
# PROVIDER CREDENTIAL CONTRACT (MANDATORY)
# =============================================================================
# Google provider uses a single ENV contract:
# - Required key: GEMINI_API_KEY
# - Key source policy: Google key must come from process ENV or local .env only
# - Runtime and CI fail fast on legacy/compat ENV key/base-url vars
#
# Examples of forbidden vars:
# GOOGLE_API_KEY, SURREAL_PASS,
# OPENAI_API_KEY, ANTHROPIC_API_KEY, GROQ_API_KEY, MISTRAL_API_KEY,
# DEEPSEEK_API_KEY, XAI_API_KEY, OPENROUTER_API_KEY, VOYAGE_API_KEY, ELEVENLABS_API_KEY,
# OLLAMA_API_BASE, VERTEX_PROJECT, VERTEX_LOCATION, GOOGLE_APPLICATION_CREDENTIALS,
# AZURE_OPENAI_API_KEY, AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_VERSION,
# OPENAI_COMPATIBLE_BASE_URL, OPENAI_COMPATIBLE_API_KEY
#
# Required Google runtime key:
# GEMINI_API_KEY=your-google-ai-studio-key
# Optional model override (Gemini-only runtime):
# GEMINI_MODEL=gemini-2.5-flash
# Optional embedding model override:
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Live test opt-in switch (required for tests/live/* and apps/web/e2e-live/*):
# RUN_LIVE_TESTS=1
# Extra safety switch for real external website browser traffic:
# LIVE_EXTERNAL_WEB_ENABLED=1
# Optional external target for live browser smoke:
# LIVE_EXTERNAL_SITE_URL=https://example.com/
# Live test heartbeat interval in seconds (minimum 5, default 15):
# LIVE_HEARTBEAT_SECONDS=15
# Optional model override for live smoke:
# LIVE_GEMINI_SMOKE_MODEL=gemini-2.5-flash
# Optional teardown evidence path for live tests:
# LIVE_TEARDOWN_EVIDENCE_FILE=.runtime-cache/evals/live-teardown.jsonl
#
# See docs/configuration.md

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# External API URL (for webhooks, callbacks, etc.)
# API_URL=http://localhost:5055

# Frontend/API runtime URL overrides (optional)
# API_URL=http://localhost:5055
# INTERNAL_API_URL=http://localhost:5055
# NEXT_PUBLIC_API_URL=http://localhost:5055

# API runtime governance
# OPEN_NOTEBOOK_ENV=development
# OPEN_NOTEBOOK_CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OPEN_NOTEBOOK_CORS_ALLOW_CREDENTIALS=true
# LOG_LEVEL=INFO
# LOG_JSON=false
# REQUEST_LOG_EXCLUDE_PATHS=/health,/docs,/openapi.json,/redoc
# REQUEST_LOG_SLOW_THRESHOLD_MS=2000
# OPEN_NOTEBOOK_ENFORCE_PROVIDER_POLICY=false
# OPEN_NOTEBOOK_SKIP_GEMINI_STARTUP_PROBE=false
# OPEN_NOTEBOOK_SKIP_MIGRATIONS=false
# OPEN_NOTEBOOK_MAX_UPLOAD_BYTES=52428800

# Content processing
# DEFAULT OPEN_NOTEBOOK_CHUNK_SIZE=1200
# DEFAULT OPEN_NOTEBOOK_CHUNK_OVERLAP=_unset_
# OPEN_NOTEBOOK_CHUNK_SIZE=1200
# OPEN_NOTEBOOK_CHUNK_OVERLAP=

# Optional API auth and helper CLIs/MCP
# OPEN_NOTEBOOK_PASSWORD=
# OPEN_NOTEBOOK_URL=http://localhost:5055
# OPEN_NOTEBOOK_API_BASE=http://localhost:5055/api
# API_CLIENT_TIMEOUT=300

# Local manual browser lane (optional)
# PROVENOTE_BROWSER_MODE=real_chrome_profile
# PROVENOTE_CHROME_USER_DATA_DIR=~/.cache/provenote/browser/chrome-user-data
# PROVENOTE_CHROME_PROFILE_NAME=provenote
# PROVENOTE_CHROME_PROFILE_KEY=Profile 1
# PROVENOTE_SOURCE_CHROME_USER_DATA_DIR=~/Library/Application Support/Google/Chrome
# PROVENOTE_SOURCE_CHROME_PROFILE_KEY=Profile 25
# PROVENOTE_CHROME_CDP_PORT=9342
# PROVENOTE_BROWSER_URL=http://127.0.0.1:3100
# Optional identity-tab overrides for the repo-owned browser lane:
# PROVENOTE_BROWSER_IDENTITY_LABEL=provenote
# PROVENOTE_BROWSER_IDENTITY_ACCENT=#2563eb

# Compatibility aliases are forbidden by contract:
# SURREAL_ADDRESS, SURREAL_PORT, SURREAL_PASS, GOOGLE_API_KEY

# Optional tracing
# OPEN_NOTEBOOK_PHOENIX_ENABLED=false
# OPEN_NOTEBOOK_PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
# OPEN_NOTEBOOK_PHOENIX_PROJECT_NAME=open-notebook
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
# PHOENIX_API_KEY=
# OPEN_NOTEBOOK_PHOENIX_API_KEY=

# For more configuration options, see:
# See docs/configuration.md

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provenote Runtime Output Registry Entry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "category",
    "canonical_path",
    "retention_class",
    "producer",
    "consumer"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "canonical_path": {
      "type": "string"
    },
    "retention_class": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "consumer": {
      "type": "string"
    }
  }
}
